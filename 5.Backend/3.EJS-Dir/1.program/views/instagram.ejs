<%- include("head.ejs") %>

<body>
    <h1 class="heading">Instagram</h1>
    <h1>Account- Name : <div class="accName"><%= data.name %></div></h1>
    <button style ="color:rgb(8, 179, 179) ;background:black "> Follow </button>
    <button style ="color:rgb(195, 31, 58);background:black"> Message </button>

    <p>Followers : <span><%= data.followers %></span>   &nbsp;&nbsp;&nbsp;&nbsp; Following : <span><%= data.following %></span>  </p>
    <hr>

    <h3>Posts :</h3>
    <% for (let post of data.posts){ %>
        <img src="<%=post.image %>" alt="image" >
    <p>Likes: <span><%= post.likes %></span>  &nbsp;&nbsp;&nbsp;&nbsp; Comments : <span><%= post.comments %></span> </p>
        

    <% } %>
    
    
</body>
</html>